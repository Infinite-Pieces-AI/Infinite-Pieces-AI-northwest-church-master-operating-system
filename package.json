{
  "name": "northwest-church-platform",
  "version": "0.2.0",
  "private": true,
  "description": "Church-owned public website, member PWA, Outreach Intelligence OS, ministry administration console, and approved outreach tooling for Boston Church Lowell / Northwest.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo dev --parallel --filter=@church/public-web --filter=@church/church-hub --filter=@church/outreach-command",
    "dev:all": "turbo dev --parallel",
    "dev:public": "pnpm --filter @church/public-web dev",
    "dev:hub": "pnpm --filter @church/church-hub dev",
    "dev:outreach": "pnpm --filter @church/outreach-command dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo test",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:authorization": "pnpm supabase:test",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:test": "supabase test db",
    "supabase:types": "supabase gen types typescript --local > packages/database/src/generated.types.ts",
    "verify:structure": "node scripts/verify-structure.mjs",
    "verify:no-real-data": "node scripts/check-no-real-data.mjs",
    "check": "pnpm verify:structure && pnpm verify:no-real-data && pnpm verify:sql-static && pnpm verify:workspace && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit",
    "verify:sql-static": "node scripts/validate-sql-static.mjs",
    "verify:workspace": "node scripts/validate-workspace-contracts.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.0",
    "prettier": "^3.6.0",
    "supabase": "2.111.0",
    "turbo": "2.10.7",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
