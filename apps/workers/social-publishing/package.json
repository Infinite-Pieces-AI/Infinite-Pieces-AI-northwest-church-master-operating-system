{
  "name": "@church/worker-social-publishing",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Publishes only human-approved social drafts; automatic publication is disabled by default.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@church/worker-runtime": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.0.0"
  }
}
