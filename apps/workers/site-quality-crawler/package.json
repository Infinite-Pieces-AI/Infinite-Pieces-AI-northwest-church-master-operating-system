{
  "name": "@church/worker-site-quality-crawler",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Crawls only the approved public church site to identify broken links, metadata gaps, structured-data gaps, stale facts, and page-quality risks.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@church/outreach": "workspace:*",
    "@church/worker-runtime": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
