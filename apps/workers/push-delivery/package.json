{
  "name": "@church/worker-push-delivery",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Delivers privacy-safe web push jobs through VAPID and revokes invalid browser subscriptions.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@church/notifications": "workspace:*",
    "@church/worker-runtime": "workspace:*",
    "web-push": "^3.6.7",
    "@church/pwa": "workspace:*"
  },
  "devDependencies": {
    "@types/web-push": "^3.6.4",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
