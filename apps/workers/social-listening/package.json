{
  "name": "@church/worker-social-listening",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Inspects approved public social conversations through official provider adapters; private groups and direct messages are excluded.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@church/outreach": "workspace:*",
    "@church/worker-runtime": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
