{
  "name": "@church/worker-content-generation",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Produces review-only outreach drafts from approved facts; it cannot reply or publish automatically.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@church/outreach": "workspace:*",
    "@church/worker-runtime": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.23.9",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
