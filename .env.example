# -----------------------------------------------------------------------------
# Local starter configuration. Never commit real production secrets.
# -----------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_HUB_URL=http://localhost:3001
NEXT_PUBLIC_CHURCH_HUB_URL=http://localhost:3001
NEXT_PUBLIC_OUTREACH_URL=http://localhost:3002
NEXT_PUBLIC_ENABLE_DEMO=true
NEXT_PUBLIC_PWA_ENABLED=true
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_WELCOME_VIDEO_EMBED_URL=

# Browser-safe Supabase values. Security still depends on correct RLS.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Server / worker / Edge Function values. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
INVITATION_TOKEN_PEPPER=replace-with-at-least-32-random-characters
WEBHOOK_SIGNING_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-at-least-32-random-characters
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:technology@example.invalid
WEB_PUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com
PUBLIC_REVALIDATION_SECRET=replace-with-at-least-32-random-characters
WORKER_DRY_RUN=true
ALLOWED_APP_ORIGIN=http://localhost:3001
ALLOWED_OUTREACH_ORIGIN=http://localhost:3002
CHURCH_HUB_URL=http://localhost:3001
OUTREACH_URL=http://localhost:3002
PUBLIC_SITE_URL=http://localhost:3000
OUTREACH_SESSION_MAX_AGE_SECONDS=3600
PUBLIC_SITE_CRAWL_ENABLED=false

# Optional invitation email adapter for an existing authenticated user.
EMAIL_DELIVERY_WEBHOOK_URL=
EMAIL_DELIVERY_WEBHOOK_TOKEN=
ALLOW_LOCAL_INVITE_TOKEN_RETURN=true

# Optional ministry integrations. Keep disabled until governance approval and vendor setup.
PLANNING_CENTER_BASE_URL=https://api.planningcenteronline.com
PLANNING_CENTER_APP_ID=
PLANNING_CENTER_SECRET=
PLANNING_CENTER_WEBHOOK_VERIFICATION_MODE=disabled
PLANNING_CENTER_WEBHOOK_SECRET=
BIBLE_PROVIDER=youversion
BIBLE_PROVIDER_API_KEY=
AI_PROVIDER=disabled
AI_API_KEY=
EMAIL_PROVIDER=disabled
EMAIL_API_KEY=
PUBLIC_ANALYTICS_PROVIDER=disabled
PUBLIC_ANALYTICS_KEY=
NEXT_PUBLIC_PUBLIC_ANALYTICS_PROVIDER=disabled
GOOGLE_SEARCH_CONSOLE_PROPERTY=
SEARCH_CONSOLE_PROXY_URL=
SEARCH_CONSOLE_PROXY_TOKEN=
SEARCH_CONSOLE_DATA_STATE=final
GENERATIVE_AI_SEARCH_REPORTING_ENABLED=false
SOCIAL_AUTO_PUBLISH_ENABLED=false

# Outreach Intelligence OS connector proxies. They must be church-approved,
# server-side, HTTPS, allowlisted, and compliant with each source platform's terms.
OUTREACH_SOURCE_SCAN_ENABLED=false
PUBLIC_LISTENING_PROXY_URL=
PUBLIC_LISTENING_PROXY_TOKEN=
PUBLIC_LISTENING_ALLOWED_HOSTS=
SOCIAL_LISTENING_PROXY_URL=
SOCIAL_LISTENING_PROXY_TOKEN=
SOCIAL_LISTENING_ALLOWED_HOSTS=
AI_VISIBILITY_PROXY_URL=
AI_VISIBILITY_PROXY_TOKEN=
AI_VISIBILITY_ALLOWED_HOSTS=
CONTENT_GENERATION_PROXY_URL=
CONTENT_GENERATION_PROXY_TOKEN=
CONTENT_GENERATION_ALLOWED_HOSTS=
OUTREACH_AUTO_REPLY_ENABLED=false
OUTREACH_AUTOMATIC_CONTACT=false
OUTREACH_AUTOMATIC_PUBLISHING=false

# Data safety defaults.
ALLOW_REAL_CHILD_DATA=false
ALLOW_AUTOMATIC_SOCIAL_PUBLISHING=false
ALLOW_AI_PRIVATE_DATA_ACCESS=false
ALLOW_CUSTOM_CHILD_RELEASE=false
CHILD_RELEASE_SAFETY_REVIEW_ID=
